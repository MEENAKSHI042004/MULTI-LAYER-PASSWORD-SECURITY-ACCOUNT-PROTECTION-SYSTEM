# Copy to .env (git-ignored) and fill in. NEVER commit real values.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

FLASK_SECRET_KEY=
JWT_SECRET_KEY=
# Optional: previous JWT secret, kept during a rotation so live tokens stay valid
# JWT_SECRET_KEY_PREVIOUS=

# Leave unset for local SQLite; Postgres example:
# DATABASE_URL=postgresql://user:password@host:5432/mlpsaps
SEED_ADMIN_PASSWORD=

# Origins allowed to call /api/* cross-origin (comma-separated, never "*")
CORS_ALLOWED_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# WebAuthn: RP ID is the bare host; origins are full scheme://host[:port]
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5000,http://localhost:5001

# Number of trusted reverse proxies in front of the app. 0 locally.
TRUST_PROXY_HOPS=0

# Storefront only
MLPSAPS_API_BASE=http://localhost:5000
